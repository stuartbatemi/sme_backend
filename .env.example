# ============================================================
# .env.example — copy this to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# Node server port
PORT=5000

# MySQL database (your existing sme_project database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Stuartson$55
DB_NAME=sme_project

# JWT secrets — change these to any long random strings
# You can generate one at: https://randomkeygen.com/
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_this_with_a_long_random_string_refresh

# Token expiry times
JWT_ACCESS_EXPIRES=10m
JWT_REFRESH_EXPIRES=7d

# ── Model servers ───────────────────────────────────────────
# Regular model (your existing sme_model service)
FASTAPI_URL=http://127.0.0.1:8000

# NEW — Lonet 2.5 (Premium) model service.
# Once you deploy sme_model_premium as its own Railway service,
# put its public URL here. Premium users (JWT tier === 'premium')
# get routed to this URL automatically by routes/advisory.js.
# If left blank/unset, Premium users safely fall back to FASTAPI_URL
# above instead of breaking.
FASTAPI_URL_PREMIUM=

# Environment
NODE_ENV=development
