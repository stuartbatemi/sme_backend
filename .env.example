# ============================================================
# .env.example — copy this to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# Node server port
PORT=5000

# MySQL database (your existing sme_project database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=sme_project

# JWT secrets — NEVER use a placeholder or a value you've shared/committed
# anywhere. Generate real ones with: openssl rand -hex 64
# Use a DIFFERENT value for each of these two.
JWT_ACCESS_SECRET=generate_your_own_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=generate_a_different_one_the_same_way

# Demo payments — see routes/user.js. Keep this OFF once Stripe is wired
# for real money; ON is fine for coursework/demo grading.
ALLOW_DEMO_PAYMENTS=true

# Token expiry times
JWT_ACCESS_EXPIRES=10m
JWT_REFRESH_EXPIRES=7d

# ── Model servers ───────────────────────────────────────────
# Regular model (your existing sme_model service)
FASTAPI_URL=http://127.0.0.1:8001

# NEW — Lonet 2.5 (Premium) model service.
# Once you deploy sme_model_premium as its own Railway service,
# put its public URL here. Premium users (JWT tier === 'premium')
# get routed to this URL automatically by routes/advisory.js.
# If left blank/unset, Premium users safely fall back to FASTAPI_URL
# above instead of breaking.
FASTAPI_URL_PREMIUM=smemodelpremium-production.up.railway.app

# Environment
NODE_ENV=development

# ── Email (forgot-password: OTP + reset-link) — via SendGrid ──
# SendGrid supports plain SMTP relay, so no extra library is needed.
# Get an API key: SendGrid dashboard > Settings > API Keys > Create
# API Key (needs at least "Mail Send" permission). Use that key as
# SMTP_PASSWORD below — the SMTP_USER is literally the string "apikey".
# If these are left blank, the server won't crash — forgot-password
# will still "succeed" from the user's perspective, but the OTP/link
# is just printed to the server console instead of emailed (see
# utils/mailer.js).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=
# Must be a sender you've verified in SendGrid (Settings > Sender Authentication)
SMTP_FROM=Fursa <no-reply@yourdomain.com>

# Used to build the password-reset link sent by email — should be
# your deployed frontend's origin (e.g. https://fursa.app)
FRONTEND_URL=http://localhost:3002

# ── SMS (forgot-password: OTP to +255 numbers) — via Beem Africa ──
# Get keys from the Beem Africa dashboard: Profile > Authentication
# Information (API key + Secret key). SENDER_ID needs to be an
# approved Sender Name in your Beem account, or leave as 'INFO' to
# use Beem's shared default sender while testing.
# If BEEM_API_KEY/BEEM_SECRET_KEY are left blank, the server won't
# crash — the OTP is printed to the console instead (see utils/sms.js).
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=INFO

# ── AI Consultant (routes/consultant.js) — Groq API, free tier ───
# Free key from console.groq.com. Uses the "groq/compound" system,
# which adds real, built-in web search (via Tavily) on top of a
# strong underlying model — this is what lets the consultant name
# actual nearby competing businesses instead of just describing the
# industry in general terms. Requires no separate search API key;
# web search is bundled into the compound model call itself.
GROQ_API_KEY=

# ── Bot verification at sign-up (routes/auth.js) — Cloudflare Turnstile, free ──
# Get a site key + secret key from dash.cloudflare.com/?to=/:account/turnstile
# (just needs a free Cloudflare account, no domain purchase required).
# The SITE key goes in the frontend's VITE_TURNSTILE_SITE_KEY — this is
# the matching SECRET key, used server-side to verify the token the
# widget produces. If left blank, registration skips the bot check
# entirely (fails open) rather than blocking local development —
# don't deploy to production without setting this.
TURNSTILE_SECRET_KEY=
